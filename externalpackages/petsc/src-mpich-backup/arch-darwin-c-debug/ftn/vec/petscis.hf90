  function ISColoringnotequals(A,B)
    logical ISColoringnotequals
    type(tISColoring), intent(in) :: A,B
    ISColoringnotequals = (A%v .ne. B%v)
  end function
  function ISColoringequals(A,B)
    logical ISColoringequals
    type(tISColoring), intent(in) :: A,B
    ISColoringequals = (A%v .eq. B%v)
  end function
