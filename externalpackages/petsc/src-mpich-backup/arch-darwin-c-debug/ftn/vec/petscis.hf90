#endif

  function PetscKDTreenotequals(A,B)
    logical PetscKDTreenotequals
    type(tPetscKDTree), intent(in) :: A,B
    PetscKDTreenotequals = (A%v .ne. B%v)
  end function
  function PetscKDTreeequals(A,B)
    logical PetscKDTreeequals
    type(tPetscKDTree), intent(in) :: A,B
    PetscKDTreeequals = (A%v .eq. B%v)
  end function
