#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscSFnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscSFequals
#endif

  function PetscSFnotequals(A,B)
    logical PetscSFnotequals
    type(tPetscSF), intent(in) :: A,B
    PetscSFnotequals = (A%v .ne. B%v)
  end function
  function PetscSFequals(A,B)
    logical PetscSFequals
    type(tPetscSF), intent(in) :: A,B
    PetscSFequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastSF(obj)
    PetscSF obj
    PetscObject PetscObjectCastSF
    PetscObjectCastSF%v = obj%v
  end function 
  subroutine PetscBarrierSF(obj,ierr)
    PetscSF obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
