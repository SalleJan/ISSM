#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PFnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PFequals
#endif

  function PFnotequals(A,B)
    logical PFnotequals
    type(tPF), intent(in) :: A,B
    PFnotequals = (A%v .ne. B%v)
  end function
  function PFequals(A,B)
    logical PFequals
    type(tPF), intent(in) :: A,B
    PFequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastPF(obj)
    PF obj
    PetscObject PetscObjectCastPF
    PetscObjectCastPF%v = obj%v
  end function 
  subroutine PetscBarrierPF(obj,ierr)
    PF obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
