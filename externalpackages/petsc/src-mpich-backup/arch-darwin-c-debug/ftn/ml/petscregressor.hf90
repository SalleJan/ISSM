#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscRegressornotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscRegressorequals
#endif

  function PetscRegressornotequals(A,B)
    logical PetscRegressornotequals
    type(tPetscRegressor), intent(in) :: A,B
    PetscRegressornotequals = (A%v .ne. B%v)
  end function
  function PetscRegressorequals(A,B)
    logical PetscRegressorequals
    type(tPetscRegressor), intent(in) :: A,B
    PetscRegressorequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastRegressor(obj)
    PetscRegressor obj
    PetscObject PetscObjectCastRegressor
    PetscObjectCastRegressor%v = obj%v
  end function 
  subroutine PetscBarrierRegressor(obj,ierr)
    PetscRegressor obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
