#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscDAnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscDAequals
#endif

  function PetscDAnotequals(A,B)
    logical PetscDAnotequals
    type(tPetscDA), intent(in) :: A,B
    PetscDAnotequals = (A%v .ne. B%v)
  end function
  function PetscDAequals(A,B)
    logical PetscDAequals
    type(tPetscDA), intent(in) :: A,B
    PetscDAequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastDA(obj)
    PetscDA obj
    PetscObject PetscObjectCastDA
    PetscObjectCastDA%v = obj%v
  end function 
  subroutine PetscBarrierDA(obj,ierr)
    PetscDA obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
