  function PetscLimiternotequals(A,B)
    logical PetscLimiternotequals
    type(tPetscLimiter), intent(in) :: A,B
    PetscLimiternotequals = (A%v .ne. B%v)
  end function
  function PetscLimiterequals(A,B)
    logical PetscLimiterequals
    type(tPetscLimiter), intent(in) :: A,B
    PetscLimiterequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastLimiter(obj)
