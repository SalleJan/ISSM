#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: DMDAStencilTypenotequals
!DEC$ ATTRIBUTES DLLEXPORT:: DMDAStencilTypeequals
#endif

  function DMDAStencilTypenotequals(A,B)
    logical DMDAStencilTypenotequals
    type(eDMDAStencilType), intent(in) :: A,B
    DMDAStencilTypenotequals = (A%v .ne. B%v)
  end function
  function DMDAStencilTypeequals(A,B)
    logical DMDAStencilTypeequals
    type(eDMDAStencilType), intent(in) :: A,B
    DMDAStencilTypeequals = (A%v .eq. B%v)
  end function
