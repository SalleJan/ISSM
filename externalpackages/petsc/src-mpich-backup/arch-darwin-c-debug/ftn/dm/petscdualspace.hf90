  function PetscDualSpacenotequals(A,B)
    logical PetscDualSpacenotequals
    type(tPetscDualSpace), intent(in) :: A,B
    PetscDualSpacenotequals = (A%v .ne. B%v)
  end function
  function PetscDualSpaceequals(A,B)
    logical PetscDualSpaceequals
    type(tPetscDualSpace), intent(in) :: A,B
    PetscDualSpaceequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastDualSpace(obj)
    PetscDualSpace obj
    PetscObject PetscObjectCastDualSpace
    PetscObjectCastDualSpace%v = obj%v
  end function 
  subroutine PetscBarrierDualSpace(obj,ierr)
    PetscDualSpace obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
