  function PetscQuadraturenotequals(A,B)
    logical PetscQuadraturenotequals
    type(tPetscQuadrature), intent(in) :: A,B
    PetscQuadraturenotequals = (A%v .ne. B%v)
  end function
  function PetscQuadratureequals(A,B)
    logical PetscQuadratureequals
    type(tPetscQuadrature), intent(in) :: A,B
    PetscQuadratureequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastQuadrature(obj)
    PetscQuadrature obj
    PetscObject PetscObjectCastQuadrature
    PetscObjectCastQuadrature%v = obj%v
  end function 
  subroutine PetscBarrierQuadrature(obj,ierr)
