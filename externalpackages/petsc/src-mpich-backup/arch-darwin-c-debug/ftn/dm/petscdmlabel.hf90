#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: DMLabelnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: DMLabelequals
#endif

  function DMLabelnotequals(A,B)
    logical DMLabelnotequals
    type(tDMLabel), intent(in) :: A,B
    DMLabelnotequals = (A%v .ne. B%v)
  end function
  function DMLabelequals(A,B)
    logical DMLabelequals
    type(tDMLabel), intent(in) :: A,B
    DMLabelequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastDMLabel(obj)
    DMLabel obj
    PetscObject PetscObjectCastDMLabel
    PetscObjectCastDMLabel%v = obj%v
  end function 
  subroutine PetscBarrierDMLabel(obj,ierr)
    DMLabel obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
