#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscFEnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscFEequals
#endif

  function PetscFEnotequals(A,B)
    logical PetscFEnotequals
    type(tPetscFE), intent(in) :: A,B
    PetscFEnotequals = (A%v .ne. B%v)
  end function
  function PetscFEequals(A,B)
    logical PetscFEequals
    type(tPetscFE), intent(in) :: A,B
    PetscFEequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastFE(obj)
    PetscFE obj
    PetscObject PetscObjectCastFE
    PetscObjectCastFE%v = obj%v
  end function 
  subroutine PetscBarrierFE(obj,ierr)
    PetscFE obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
