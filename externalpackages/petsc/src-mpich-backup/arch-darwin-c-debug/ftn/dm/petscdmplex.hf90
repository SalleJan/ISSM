#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscGridHashnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscGridHashequals
#endif

  function PetscGridHashnotequals(A,B)
    logical PetscGridHashnotequals
    type(tPetscGridHash), intent(in) :: A,B
    PetscGridHashnotequals = (A%v .ne. B%v)
  end function
  function PetscGridHashequals(A,B)
    logical PetscGridHashequals
    type(tPetscGridHash), intent(in) :: A,B
    PetscGridHashequals = (A%v .eq. B%v)
  end function
