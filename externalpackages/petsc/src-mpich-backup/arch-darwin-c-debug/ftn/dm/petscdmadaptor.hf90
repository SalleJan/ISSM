#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: DMAdaptornotequals
!DEC$ ATTRIBUTES DLLEXPORT:: DMAdaptorequals
#endif

  function DMAdaptornotequals(A,B)
    logical DMAdaptornotequals
    type(tDMAdaptor), intent(in) :: A,B
    DMAdaptornotequals = (A%v .ne. B%v)
  end function
  function DMAdaptorequals(A,B)
    logical DMAdaptorequals
    type(tDMAdaptor), intent(in) :: A,B
    DMAdaptorequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastDMAdaptor(obj)
    DMAdaptor obj
    PetscObject PetscObjectCastDMAdaptor
    PetscObjectCastDMAdaptor%v = obj%v
  end function 
  subroutine PetscBarrierDMAdaptor(obj,ierr)
    DMAdaptor obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
