#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscSpacenotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscSpaceequals
#endif

  function PetscSpacenotequals(A,B)
    logical PetscSpacenotequals
    type(tPetscSpace), intent(in) :: A,B
    PetscSpacenotequals = (A%v .ne. B%v)
  end function
  function PetscSpaceequals(A,B)
    logical PetscSpaceequals
    type(tPetscSpace), intent(in) :: A,B
    PetscSpaceequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastSpace(obj)
    PetscSpace obj
    PetscObject PetscObjectCastSpace
    PetscObjectCastSpace%v = obj%v
  end function 
  subroutine PetscBarrierSpace(obj,ierr)
    PetscSpace obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
