#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: Characteristicnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: Characteristicequals
#endif

  function Characteristicnotequals(A,B)
    logical Characteristicnotequals
    type(tCharacteristic), intent(in) :: A,B
    Characteristicnotequals = (A%v .ne. B%v)
  end function
  function Characteristicequals(A,B)
    logical Characteristicequals
    type(tCharacteristic), intent(in) :: A,B
    Characteristicequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastCharacteristic(obj)
    Characteristic obj
    PetscObject PetscObjectCastCharacteristic
    PetscObjectCastCharacteristic%v = obj%v
  end function 
  subroutine PetscBarrierCharacteristic(obj,ierr)
    Characteristic obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
