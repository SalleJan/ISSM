  function TSnotequals(A,B)
    logical TSnotequals
    type(tTS), intent(in) :: A,B
    TSnotequals = (A%v .ne. B%v)
  end function
  function TSequals(A,B)
    logical TSequals
    type(tTS), intent(in) :: A,B
    TSequals = (A%v .eq. B%v)
  end function
