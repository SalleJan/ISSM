!DEC$ ATTRIBUTES DLLEXPORT:: KSPnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: KSPequals
#endif

  function KSPnotequals(A,B)
    logical KSPnotequals
    type(tKSP), intent(in) :: A,B
    KSPnotequals = (A%v .ne. B%v)
  end function
  function KSPequals(A,B)
    logical KSPequals
    type(tKSP), intent(in) :: A,B
    KSPequals = (A%v .eq. B%v)
  end function
