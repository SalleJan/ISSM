#endif

  function Taonotequals(A,B)
    logical Taonotequals
    type(tTao), intent(in) :: A,B
    Taonotequals = (A%v .ne. B%v)
  end function
  function Taoequals(A,B)
    logical Taoequals
    type(tTao), intent(in) :: A,B
    Taoequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastTao(obj)
    Tao obj
    PetscObject PetscObjectCastTao
    PetscObjectCastTao%v = obj%v
  end function 
  subroutine PetscBarrierTao(obj,ierr)
    Tao obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
