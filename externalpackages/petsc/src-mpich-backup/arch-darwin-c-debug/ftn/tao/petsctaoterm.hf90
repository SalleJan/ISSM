#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: TaoTermnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: TaoTermequals
#endif

  function TaoTermnotequals(A,B)
    logical TaoTermnotequals
    type(tTaoTerm), intent(in) :: A,B
    TaoTermnotequals = (A%v .ne. B%v)
  end function
  function TaoTermequals(A,B)
    logical TaoTermequals
    type(tTaoTerm), intent(in) :: A,B
    TaoTermequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastTaoTerm(obj)
    TaoTerm obj
    PetscObject PetscObjectCastTaoTerm
    PetscObjectCastTaoTerm%v = obj%v
  end function 
  subroutine PetscBarrierTaoTerm(obj,ierr)
    TaoTerm obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
