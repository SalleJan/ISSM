  function TaoLineSearchnotequals(A,B)
    logical TaoLineSearchnotequals
    type(tTaoLineSearch), intent(in) :: A,B
    TaoLineSearchnotequals = (A%v .ne. B%v)
  end function
  function TaoLineSearchequals(A,B)
    logical TaoLineSearchequals
    type(tTaoLineSearch), intent(in) :: A,B
    TaoLineSearchequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastTaoLineSearch(obj)
    TaoLineSearch obj
    PetscObject PetscObjectCastTaoLineSearch
    PetscObjectCastTaoLineSearch%v = obj%v
  end function 
  subroutine PetscBarrierTaoLineSearch(obj,ierr)
    TaoLineSearch obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
