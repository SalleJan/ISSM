#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscConvEstnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscConvEstequals
#endif

  function PetscConvEstnotequals(A,B)
    logical PetscConvEstnotequals
    type(tPetscConvEst), intent(in) :: A,B
    PetscConvEstnotequals = (A%v .ne. B%v)
  end function
  function PetscConvEstequals(A,B)
    logical PetscConvEstequals
    type(tPetscConvEst), intent(in) :: A,B
    PetscConvEstequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastConvEst(obj)
    PetscConvEst obj
    PetscObject PetscObjectCastConvEst
    PetscObjectCastConvEst%v = obj%v
  end function 
  subroutine PetscBarrierConvEst(obj,ierr)
    PetscConvEst obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
