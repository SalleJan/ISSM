#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscPartitionernotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscPartitionerequals
#endif

  function PetscPartitionernotequals(A,B)
    logical PetscPartitionernotequals
    type(tPetscPartitioner), intent(in) :: A,B
    PetscPartitionernotequals = (A%v .ne. B%v)
  end function
  function PetscPartitionerequals(A,B)
    logical PetscPartitionerequals
    type(tPetscPartitioner), intent(in) :: A,B
    PetscPartitionerequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastPartitioner(obj)
    PetscPartitioner obj
    PetscObject PetscObjectCastPartitioner
    PetscObjectCastPartitioner%v = obj%v
  end function 
  subroutine PetscBarrierPartitioner(obj,ierr)
    PetscPartitioner obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
