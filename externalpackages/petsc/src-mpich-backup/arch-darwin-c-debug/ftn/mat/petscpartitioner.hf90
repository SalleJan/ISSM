  function PetscPartitionerMultistageStrategynotequals(A,B)
    logical PetscPartitionerMultistageStrategynotequals
    type(ePetscPartitionerMultistageStrategy), intent(in) :: A,B
    PetscPartitionerMultistageStrategynotequals = (A%v .ne. B%v)
  end function
  function PetscPartitionerMultistageStrategyequals(A,B)
    logical PetscPartitionerMultistageStrategyequals
    type(ePetscPartitionerMultistageStrategy), intent(in) :: A,B
    PetscPartitionerMultistageStrategyequals = (A%v .eq. B%v)
  end function
