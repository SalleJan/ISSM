#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: MatCoarsennotequals
!DEC$ ATTRIBUTES DLLEXPORT:: MatCoarsenequals
#endif

  function MatCoarsennotequals(A,B)
    logical MatCoarsennotequals
    type(tMatCoarsen), intent(in) :: A,B
    MatCoarsennotequals = (A%v .ne. B%v)
  end function
  function MatCoarsenequals(A,B)
    logical MatCoarsenequals
    type(tMatCoarsen), intent(in) :: A,B
    MatCoarsenequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastMatCoarsen(obj)
    MatCoarsen obj
    PetscObject PetscObjectCastMatCoarsen
    PetscObjectCastMatCoarsen%v = obj%v
  end function 
  subroutine PetscBarrierMatCoarsen(obj,ierr)
    MatCoarsen obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
