#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscMatlabEnginenotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscMatlabEngineequals
#endif

  function PetscMatlabEnginenotequals(A,B)
    logical PetscMatlabEnginenotequals
    type(tPetscMatlabEngine), intent(in) :: A,B
    PetscMatlabEnginenotequals = (A%v .ne. B%v)
  end function
  function PetscMatlabEngineequals(A,B)
    logical PetscMatlabEngineequals
    type(tPetscMatlabEngine), intent(in) :: A,B
    PetscMatlabEngineequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastMatlabEngine(obj)
    PetscMatlabEngine obj
    PetscObject PetscObjectCastMatlabEngine
    PetscObjectCastMatlabEngine%v = obj%v
  end function 
  subroutine PetscBarrierMatlabEngine(obj,ierr)
    PetscMatlabEngine obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
