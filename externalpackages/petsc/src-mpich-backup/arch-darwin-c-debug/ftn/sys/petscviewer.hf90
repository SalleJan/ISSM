!DEC$ ATTRIBUTES DLLEXPORT:: PetscViewernotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscViewerequals
#endif

  function PetscViewernotequals(A,B)
    logical PetscViewernotequals
    type(tPetscViewer), intent(in) :: A,B
    PetscViewernotequals = (A%v .ne. B%v)
  end function
  function PetscViewerequals(A,B)
    logical PetscViewerequals
    type(tPetscViewer), intent(in) :: A,B
    PetscViewerequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastViewer(obj)
    PetscViewer obj
    PetscObject PetscObjectCastViewer
    PetscObjectCastViewer%v = obj%v
  end function 
  subroutine PetscBarrierViewer(obj,ierr)
    PetscViewer obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
