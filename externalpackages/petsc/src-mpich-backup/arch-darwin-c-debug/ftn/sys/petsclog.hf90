#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscLogHandlernotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscLogHandlerequals
#endif

  function PetscLogHandlernotequals(A,B)
    logical PetscLogHandlernotequals
    type(tPetscLogHandler), intent(in) :: A,B
    PetscLogHandlernotequals = (A%v .ne. B%v)
  end function
  function PetscLogHandlerequals(A,B)
    logical PetscLogHandlerequals
    type(tPetscLogHandler), intent(in) :: A,B
    PetscLogHandlerequals = (A%v .eq. B%v)
  end function
  function PetscObjectCastLogHandler(obj)
    PetscLogHandler obj
    PetscObject PetscObjectCastLogHandler
    PetscObjectCastLogHandler%v = obj%v
  end function 
  subroutine PetscBarrierLogHandler(obj,ierr)
    PetscLogHandler obj
    PetscErrorCode ierr
    call PetscBarrier(PetscObjectCast(obj),ierr)
  end subroutine 
