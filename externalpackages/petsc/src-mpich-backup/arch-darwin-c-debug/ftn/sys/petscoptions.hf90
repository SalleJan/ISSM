#if defined(_WIN32) && defined(PETSC_USE_SHARED_LIBRARIES)
!DEC$ ATTRIBUTES DLLEXPORT:: PetscOptionsnotequals
!DEC$ ATTRIBUTES DLLEXPORT:: PetscOptionsequals
#endif

  function PetscOptionsnotequals(A,B)
    logical PetscOptionsnotequals
    type(tPetscOptions), intent(in) :: A,B
    PetscOptionsnotequals = (A%v .ne. B%v)
  end function
  function PetscOptionsequals(A,B)
    logical PetscOptionsequals
    type(tPetscOptions), intent(in) :: A,B
    PetscOptionsequals = (A%v .eq. B%v)
  end function
